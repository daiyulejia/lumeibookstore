# Windows 批处理必须是 CRLF —— 否则 cmd.exe 解析错乱
# （踩过的坑：.bat 被写成 LF 后 `start.bat` 直接乱码报错）
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 脚本必须是 LF
*.sh text eol=lf

# 二进制素材别做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
