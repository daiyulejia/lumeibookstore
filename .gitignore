# 虚拟环境 —— 换平台就得重建，不进版本库
.venv/
__pycache__/
*.pyc

# 打包产物
dist/
# ⚠ 例外：前端构建产物**必须进版本库**。
#   服务器是纯 Python，不装 node、不跑构建 —— 它只拿现成的静态文件。
#   所以 app/static/dist/ 里的东西是"要部署的东西"，不是中间产物。
#   （不加这条排除的话，`git push` 之后服务器上的目录还是空的，
#     线上会 404 白屏。）
!app/static/dist/
!app/static/dist/**

# 前端依赖：几万个文件，机器上有 npm 就能重装
frontend/node_modules/

# 下载的二进制（cloudflared，55MB，用的时候会自己下）
tools/bin/

# ---------------------------------------------------------------------------
# 运行期产物
# ---------------------------------------------------------------------------
logs/
cache/serve.pid
.run.log

# 开发期截图
shots/

# ---------------------------------------------------------------------------
# 用户数据 / 密钥 —— 一律不进版本库
# ---------------------------------------------------------------------------
# 书架：用户自己收藏的书目，属于个人数据
library/
# 下载下来的小说正文
downloads/
# 缓存里既有可再生的索引（registry/ranks），也有**密钥**（auth.json 存访问令牌）
# —— 整目录排除最省心，反正线上会自己重抓
cache/
# 访问令牌明文（docs 文件，含隧道钥匙）
远程访问.txt
# 素材原图 / 中间产物
tmp_assets/
src-img/

# 编辑器
.idea/
.vscode/
.DS_Store
